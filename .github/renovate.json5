{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":enablePreCommit"],
  "schedule": ["after 12am and before 5am on the 1st day of the month"],
  "enabledManagers": ["github-actions", "pre-commit", "pixi"],
  "commitMessagePrefix": "chore(bot):",
  "automerge": true,
  "minimumReleaseAge": "7 days",
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "groupName": "GitHub Actions",
      "matchManagers": ["github-actions"],
      "description": "Monthly update of GitHub Actions",
      "pinDigests": true
    },
    {
      "groupName": "HoloViz Tasks",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["holoviz-dev/holoviz_tasks"],
      "minimumReleaseAge": "0 days",
      "schedule": ["after 12am and before 5am"]
    },
    {
      "groupName": "pre-commit dependencies",
      "matchManagers": ["pre-commit"],
      "description": "Monthly update of pre-commit"
    },
    {
      "matchManagers": ["pixi"],
      "description": "Only allow Pixi lock file maintenance, not direct dependency bumps",
      "enabled": false,
    },
    {
      "groupName": "Pixi Lock",
      "matchManagers": ["pixi"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "description": "Weekly update of Pixi Lock",
      "schedule": ["before 5am on monday"],
      "minimumReleaseAge": "0 days", // Handled in pixi itself
      "commitMessageAction": "Update",
      "commitMessageTopic": "pixi.lock",
      "branchTopic": "pixi-lock",
      "enabled": true,
    },
  ]
}
